			"Salary": {
				"title": "Salary",
				"description": "Faixa salarial tipada (ADR-006, decisão 5 — vazamento 3). O texto livre continua aceito no campo `salary` do Job como fallback de compatibilidade, mas dois provedores só interoperam em busca com a forma tipada.",
				"type": "object",
				"properties": {
					"min": {
						"type": [
							"number",
							"null"
						],
						"minimum": 0
					},
					"max": {
						"type": [
							"number",
							"null"
						],
						"minimum": 0
					},
					"currency": {
						"type": "string",
						"description": "ISO-4217 (ex.: BRL, USD).",
